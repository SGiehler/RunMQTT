{
  "name": "runmqtt",
  "productName": "RunMQTT",
  "version": "1.0.0",
  "description": "Windows desktop app for MQTT-based command execution",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win"
  },
  "keywords": [
    "mqtt",
    "automation",
    "desktop"
  ],
  "author": "",
  "license": "CC-BY-NC-SA-4.0",
  "build": {
    "appId": "com.runmqtt.app",
    "productName": "RunMQTT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "RunMQTT-Portable.exe"
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "jest": "^29.7.0",
    "vite": "^5.0.10",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "jsonpath-plus": "^10.3.0",
    "mqtt": "^5.3.4"
  }
}